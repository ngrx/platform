{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "stripInternal": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "outDir": "../../dist/modules/router-store",
    "paths": {
      "@ngrx/router-store/schematics-core": ["./schematics-core"]
    },
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["es2018", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "target": "es2018"
  },
  "include": ["migrations/**/*.ts", "schematics/**/*.ts"],
  "exclude": ["**/*.spec.ts"],
  "angularCompilerOptions": {
    "skipMetadataEmit": true,
    "enableSummariesForJit": false,
    "enableIvy": false
  }
}
